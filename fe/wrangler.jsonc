{
  // Vercel 대체용 Cloudflare Worker: 정적 자산(dist/) + /api 중계.
  // account_id 는 여기에 적지 않는다 — CI 에서 CLOUDFLARE_ACCOUNT_ID 환경변수로만 주입한다.
  // prod 연결(V-3): zone route 로 quest.dhbang.co.kr/* 를 이 Worker 가 가로챈다. 기존 Vercel 행 CNAME(프록시됨)은 그대로 둔다.
  // 복귀 순서: ① 대시보드에서 route 삭제(즉시 Vercel 복귀) ② 이 routes 키를 제거하는 PR 을 올린다.
  //   routes 키 제거 PR 이 머지되기 전에는 다른 fe/** 변경을 main 에 머지하지 않는다 — fe-cd 의 deploy-workers 가 route 를 다시 만든다.
  // zone_name 형식은 배포 때 zone 조회를 하므로 배포 토큰에 dhbang.co.kr 존의 Zone Read 권한이 필요하다.
  // Custom Domain 은 쓰지 않는다 — 기존 CNAME 삭제가 필요해 전환 중 공백이 생기고 복귀도 느리다.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devquest-fe",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "routes": [{ "pattern": "quest.dhbang.co.kr/*", "zone_name": "dhbang.co.kr" }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // 백엔드 스위치(KV 바인딩 SWITCH)는 네임스페이스 생성 후 kv_namespaces 로 추가한다. 바인딩이 없으면 Worker 는 늘 Fly 로 중계한다.
  "vars": {
    "API_ORIGIN": "https://api.quest.dhbang.co.kr",
    "EKS_ORIGIN": "https://eks.quest.dhbang.co.kr"
  }
}
